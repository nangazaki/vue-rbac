{
  "name": "@nangazaki/vue-rbac",
  "version": "1.0.5",
  "homepage": "https://vue-rbac.nangazaki.io",
  "description": "Role-Based Access Control (RBAC) implementation for Vue.js",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "vue",
    "rbac",
    "access-control",
    "roles",
    "permissions",
    "directive",
    "vue3",
    "vue-rbac"
  ],
  "author": "Helder Cambuta",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nangazaki/vue-rbac.git"
  },
  "peerDependencies": {
    "vue": "^3.3.0 || ^3.4.0 || ^3.5.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "rollup -c --bundleConfigAsCjs -w",
    "build": "rollup -c --bundleConfigAsCjs",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "release:patch": "node scripts/bump-version.mjs patch",
    "release:minor": "node scripts/bump-version.mjs minor",
    "release:major": "node scripts/bump-version.mjs major"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.2",
    "@typescript-eslint/eslint-plugin": "^8.31.0",
    "@typescript-eslint/parser": "^8.31.0",
    "eslint": "^9.25.1",
    "jsdom": "^27.0.0",
    "rollup": "^4.40.0",
    "rollup-plugin-terser": "^7.0.2",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "vue": "^3.5.13"
  },
  "packageManager": "pnpm@10.30.2+sha512.36cdc707e7b7940a988c9c1ecf88d084f8514b5c3f085f53a2e244c2921d3b2545bc20dd4ebe1fc245feec463bb298aecea7a63ed1f7680b877dc6379d8d0cb4",
  "dependencies": {
    "@vue/test-utils": "^2.4.6"
  }
}
